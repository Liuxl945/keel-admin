# 复制为 .env 后按需修改
NODE_ENV=development
PORT=3300
# 允许的跨域来源，多个用逗号分隔；* 表示全部（仅开发）
CORS_ORIGIN=*

# 数据库：postgres（默认，Docker 启动） | mysql | sqlite
DB_TYPE=postgres

# PostgreSQL（默认）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=admin_base

# MySQL 时改为：
# DB_TYPE=mysql
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

# 本地 SQLite 快速试用时改为：
# DB_TYPE=sqlite
# DB_SQLITE_PATH=data/dev.sqlite

DB_LOGGING=false

# JWT：生产必须替换为足够随机的长字符串
JWT_SECRET=dev-only-secret-change-me-please
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_AUDIENCE=admin
JWT_APP_AUDIENCE=app

# 在线开发数据源密码加密密钥（可选，至少 16 位）
# 不配置时回退使用 JWT_SECRET；轮换后旧数据源密码需要重新保存
# DATA_SOURCE_SECRET=

# 上传
UPLOAD_DIR=uploads
# 遗留整文件接口 /api/admin/upload 的上限
UPLOAD_MAX_SIZE_MB=10
# 分片上传：单片大小与单文件上限
UPLOAD_CHUNK_SIZE_MB=5
UPLOAD_MAX_FILE_SIZE_MB=2048

# 首次启动创建的超管密码（生产必须修改）
SEED_ADMIN_PASSWORD=KEEL@123456

# 微信小程序登录：本地开发置 WECHAT_MOCK=true 跳过真实 code2session
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=true

LOG_LEVEL=info
