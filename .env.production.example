# 生产部署环境变量：复制为 .env.production 后修改（scripts/deploy.sh 会自动生成）
# 该文件同时被 docker compose（变量替换）和 server 容器（env_file）读取。

# ---- 对外端口 ----
HTTP_PORT=8092

# ---- 数据库（容器内网，不对外暴露，默认 PostgreSQL）----
POSTGRES_DB=admin_base
POSTGRES_USER=postgres
# 必须改成强密码；deploy.sh 首次生成时会自动填随机值
POSTGRES_PASSWORD=change-me-strong-password

# ---- 后端 ----
# 至少 32 位随机串；生成方式：openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-random
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# 数据源密码加密密钥，不填则回退 JWT_SECRET；一旦使用不要随意更换
DATA_SOURCE_SECRET=change-me-datasource-secret

# 允许的跨域来源：同域反代时保持 * 即可；前后端分域名时写具体域名，逗号分隔
CORS_ORIGIN=*

# 首次启动创建的超管密码（登录后立即修改）
SEED_ADMIN_PASSWORD=KEEL@123456

# 首次启动创建的演示账户 demo 密码（只读/受限角色，可公开演示）
SEED_DEMO_PASSWORD=Demo@123456

# 上传
UPLOAD_MAX_SIZE_MB=10
UPLOAD_CHUNK_SIZE_MB=5
UPLOAD_MAX_FILE_SIZE_MB=2048

# App 微信登录：本次只部署 server + admin，未部署 App 端时可留空；
# 后续部署 App 时再填 APPID/SECRET，并把 WECHAT_MOCK 置为 false。
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=true

LOG_LEVEL=info
